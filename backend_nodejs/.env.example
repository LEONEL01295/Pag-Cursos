# docker-compose.yml (opcional)
cat > docker-compose.yml << 'DOCKER_EOF'
version: '3.8'

services:
  backend:
    build: ./backend_nodejs
    ports:
      - "3000:3000"
    environment:
      - NODE_ENV=development
      - PORT=3000
    volumes:
      - ./backend_nodejs:/app
    command: npm run dev

  mongodb:
    image: mongo:latest
    ports:
      - "27017:27017"
    volumes:
      - mongo_data:/data/db

volumes:
  mongo_data:
DOCKER_EOF

